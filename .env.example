# Fill in your values here then rename this file to .env

NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Neo4j bulk import (scripts/submit_import_TCGA.sh + import_TCGA/) ---------
# The combined store is built offline on BlueBEAR, dumped to one artifact, and
# loaded on the Enterprise host. Some vars are per-host (noted below).

# Combined target database name (all projects land in one graph).
NEO4J_DATABASE=lifesphere

# BlueBEAR build side ---------------------------------------------------------
# neo4j-admin version MUST match the Enterprise server (store/dump format is
# version-specific). Image is pulled once as an Apptainer .sif.
NEO4J_VERSION=2026.04
NEO4J_SIF=${PROJECT_DIR}/containers/neo4j-${NEO4J_VERSION}-enterprise.sif
# Persistent /rds path where the .dump + constraints land (survives job end).
HPC_DUMP_DIR=${PROJECT_DIR}/data/dumps

# Enterprise load side --------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
# ssh/scp source for pulling the dump off BlueBEAR (Enterprise -> HPC).
HPC_SSH=user@bluebear.bham.ac.uk
# local dir on the Enterprise host to receive the .dump (neo4j-admin --from-path).
LOCAL_DUMP_DIR=/var/lib/neo4j/import-dumps
